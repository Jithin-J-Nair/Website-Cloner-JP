{
  "name": "lusion-studio-reconstruction",
  "version": "1.0.0",
  "private": true,
  "description": "Lusion (https://lusion.co/) \u2014 Reference-Faithful Interactive 3D & WebGL Studio Reconstruction (Next.js App Router, Three.js / R3F, Custom GLSL Shaders, Clean-Room Asset Pipeline)",
  "author": "Lusion Reconstruction Engineering",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/generate-about-card-ink.mjs",
    "build": "next build",
    "postbuild": "cp -r public .next/standalone/ && cp -r media-bundle .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "HOSTNAME=0.0.0.0 PORT=${PORT:-3000} node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:about-portrait": "node scripts/test-about-portrait.mjs",
    "test:assets": "node scripts/test-asset-route.mjs",
    "test:motion": "node scripts/test-home-motion.mjs && node scripts/test-home-pointer-decay.mjs && node scripts/test-home-native-physics.mjs",
    "test:about-clients": "node scripts/test-about-client-layout.mjs",
    "test:project-gallery-text": "node scripts/test-project-gallery-text-browser.mjs",
    "test:project-preview": "node scripts/test-project-preview-browser.mjs",
    "validate:home-motion": "node scripts/validate-home-motion.mjs",
    "qa": "node scripts/qa-verify.mjs",
    "validate:browser": "node scripts/phase-c-home-validate.mjs",
    "audit:phase-e": "node scripts/phase-e-audit.mjs",
    "about:capture": "node scripts/about-capture.mjs",
    "about:contact-sheet": "node scripts/about-contact-sheet.mjs",
    "about:accessibility": "node scripts/validate-about-accessibility.mjs",
    "about:budget": "node scripts/capture-about-budget.mjs",
    "test:projects": "node scripts/test-projects-archive.mjs",
    "test:about-copy": "node scripts/test-about-copy.mjs",
    "test:preloader-a11y": "node scripts/test-preloader-a11y.mjs",
    "test:navigation-a11y": "node scripts/test-navigation-a11y.mjs",
    "test:home-editorial": "node scripts/test-home-editorial.mjs",
    "validate:home-editorial": "node scripts/validate-home-editorial.mjs",
    "test:projects-contact": "node scripts/test-projects-contact-fluid.mjs",
    "validate:projects-motion": "node scripts/validate-projects-motion.mjs",
    "validate:projects-fallbacks": "node scripts/validate-projects-fallbacks.mjs",
    "test:home-hdr": "node scripts/test-home-hdr-assets.mjs",
    "validate:home-native": "node scripts/validate-home-native-hero.mjs",
    "test:about-expertise": "node scripts/test-about-expertise-motion.mjs",
    "validate:about-expertise": "node scripts/validate-about-expertise.mjs",
    "test:case-shadows": "node scripts/test-case-shadow-pipeline.mjs",
    "test:navigation-motion": "node scripts/test-route-transition-motion.mjs",
    "validate:navigation-motion": "node scripts/validate-shared-navigation.mjs",
    "test:project-zoom": "node scripts/test-project-zoom-motion.mjs",
    "validate:project-zoom": "node scripts/validate-project-zoom.mjs",
    "validate:project-zoom-lifecycle": "node scripts/validate-project-zoom-lifecycle.mjs",
    "test:case-clarity": "node scripts/test-case-study-clarity.mjs",
    "validate:case-clarity": "node scripts/validate-case-study-clarity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.6.0",
    "next": "16.4.3",
    "postprocessing": "^6.39.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
